# MongoDB Atlas connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<appName>
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=myApp

# OpenAI API key (used for LLM-powered translation)
OPENAI_API_KEY=sk-...

# GNews API key (news fetching)
NEWS_API_KEY=your_gnews_api_key

# WorldNewsAPI key (full article content extraction)
NEWS_SCRAPPER_API_KEY=your_worldnewsapi_key

# Notion API key (feedback storage)
NOTION_API_KEY=secret_...

# Notion database ID where feedback entries are stored
NOTION_DATABASE_ID=your_notion_database_id

# Flask debug mode (set to true only in development)
FLASK_DEBUG=false

# Port (optional, defaults to 5000)
PORT=5000
